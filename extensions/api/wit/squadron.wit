package squadron:api@1.7.0;

interface types {
  /// The agent a call is about.
  record agent {
    id: string,
    name: string,
    project: string,
    /// The folder the agent works in: its worktree, or its project.
    dir: string,
  }

  /// An agent open in Squadron, with what it is doing. Since 1.1.0.
  record agent-state {
    agent: agent,
    /// `working`, `waiting`, `done`, `interrupted` or `error`.
    status: string,
    /// When the status last changed, in milliseconds since 1970.
    since: u64,
    pinned: bool,
    remote: bool,
    /// Open on screen.
    shown: bool,
    /// The branch of its worktree, when it has one.
    branch: option<string>,
    /// `archive-agent` would archive it now.
    archivable: bool,
  }

  record output {
    /// -1 when the program was stopped or could not report one.
    code: s32,
    stdout: string,
    stderr: string,
  }

  record request {
    method: string,
    url: string,
    /// `{{name}}` in a value is replaced by the extension's secret `name`, which the extension never reads, `{{<account>.<field>}}` by a field of one of its accounts, and `{{base64:<a>:<b>}}` by the base64 of the values of `a` and `b` joined by `:`, as HTTP Basic auth wants.
    headers: list<tuple<string, string>>,
    body: option<string>,
  }

  record response {
    status: u16,
    headers: list<tuple<string, string>>,
    body: string,
  }

  /// A response whose body is kept as bytes, for images and files. Since 1.3.0.
  record bytes-response {
    status: u16,
    headers: list<tuple<string, string>>,
    body: list<u8>,
  }

  /// A response whose body went to a file of the extension's data folder. Since 1.3.0.
  record saved-file {
    status: u16,
    headers: list<tuple<string, string>>,
    /// The absolute path of the file.
    path: string,
    size: u64,
  }

  /// An account the user added in Settings › Extensions, without its secret fields. Since 1.3.0.
  record account {
    id: string,
    /// The fields of kind `text` and `host`, by their id in the manifest.
    fields: list<tuple<string, string>>,
  }

  /// A project of Squadron, without its folder. Since 1.7.0.
  record project {
    /// Opaque and stable, never the folder.
    id: string,
    name: string,
    /// `#rrggbb`, when the user gave it a color.
    color: option<string>,
    /// The id of its group, when it is in one.
    group: option<string>,
    archived: bool,
    /// When one of its agents last changed, in milliseconds since 1970, 0 without agents.
    active: u64,
    /// Distinct agents that changed over the last 7 days, archived ones included.
    week-agents: u32,
    /// All its agents, archived ones included.
    agents: u32,
  }

  /// A group of projects. Since 1.7.0.
  record group {
    id: string,
    name: string,
    /// The id of the group it is in, when it is nested.
    parent: option<string>,
  }

  /// An agent and what it is doing, without its folder, conversation, prompts, tool inputs or outputs, or costs. Since 1.7.0.
  record agent-activity {
    id: string,
    /// The id of its project, as `projects` gives it.
    project: string,
    /// Empty while Squadron has not named it yet. Text anyone can set: show it as text.
    name: string,
    /// `working`, `waiting`, `done`, `interrupted` or `error`.
    status: string,
    /// While `waiting`: `permission` or `question`.
    waiting: option<string>,
    /// While `working`: the name of the tool it runs, never its input.
    tool: option<string>,
    /// `crash` (its process stopped or could not start) or `api` (Claude's API refused its turn) while `error`, `mcp` when one of its MCP servers failed to connect.
    error: option<string>,
    /// The id of the agent that started it, none when the user did.
    by: option<string>,
    archived: bool,
    /// When it last changed, in milliseconds since 1970.
    since: u64,
  }

  /// A rate limit window of Claude. Since 1.7.0.
  record usage-window {
    /// From 0 to 1.
    utilization: f64,
    /// When the window starts again, in milliseconds since 1970.
    resets-at: option<u64>,
  }

  /// Claude's rate limits and whether its API answers. Since 1.7.0.
  record claude-usage {
    /// The 5-hour session, when Squadron has read it.
    five-hour: option<usage-window>,
    /// The week, when Squadron has read it.
    seven-day: option<usage-window>,
    /// `ok`, `overloaded`, `outage`, `offline` or `signed_out`.
    api: string,
    /// While `overloaded`: the retries Claude Code made so far.
    retries: u32,
    /// When `api` last changed, in milliseconds since 1970.
    since: u64,
  }
}

interface host {
  use types.{account, agent-activity, agent-state, bytes-response, claude-usage, group, output, project, request, response, saved-file};

  /// Writes a line to Squadron's log.
  log: func(message: string);
  /// Shows a notification.
  notify: func(title: string, body: string);
  /// Adds text to the message the user is writing to an agent.
  insert-prompt: func(agent: string, text: string);
  /// Shows a short badge on one of the extension's items, or removes it.
  set-badge: func(item: string, badge: option<string>);
  /// Replaces the label of one of the extension's items, or restores the manifest's.
  set-label: func(item: string, label: option<string>);
  /// The extension's own storage, kept across restarts.
  state-get: func(key: string) -> option<string>;
  state-set: func(key: string, value: option<string>);
  /// Runs a program the user allowed in `permissions.exec`, without a shell, for at most 120 s.
  exec: func(program: string, args: list<string>, dir: option<string>) -> result<output, string>;
  /// Sends an HTTPS request to a host the user allowed in `permissions.network`, or to the `host` field of one of its accounts, for at most 30 s and 8 MB.
  fetch: func(request: request) -> result<response, string>;
  /// Sends a JSON message to one of the extension's open panels, which receives it in `squadron.on`.
  panel-post: func(panel: string, message: string);
  /// The agents open in Squadron, archived ones aside. Needs `agents: ["read"]` in `permissions`. Since 1.1.0.
  agents: func() -> result<list<agent-state>, string>;
  /// Archives an agent, as the user would. Refused while it works, waits for the user, is pinned, remote or shown. Needs `agents: ["archive"]` in `permissions`. Since 1.1.0.
  archive-agent: func(agent: string) -> result<_, string>;
  /// Sends the event `timer` in `seconds`, 10 at least, and replaces the one pending. Since 1.1.0.
  set-timer: func(seconds: u32);
  /// A folder of the extension's own, made on the first call and kept across restarts and updates, for the files `exec` works on. Since 1.2.0.
  data-dir: func() -> string;
  /// The accounts the user added for the extension. Since 1.3.0.
  accounts: func() -> list<account>;
  /// Like `fetch`, with the body as bytes. Since 1.3.0.
  fetch-bytes: func(request: request) -> result<bytes-response, string>;
  /// Like `fetch`, writing the body to `name` in the extension's data folder, for at most 120 s and 200 MB. `name` is a relative path made of plain names. Since 1.3.0.
  download: func(request: request, name: string) -> result<saved-file, string>;
  /// Opens a document or an image of the extension's data folder in the user's app for it. Programs are refused. Since 1.3.0.
  open-file: func(path: string) -> result<_, string>;
  /// Like `exec`, writing `input` to the program's standard input. Since 1.3.0.
  exec-input: func(program: string, args: list<string>, dir: option<string>, input: string) -> result<output, string>;
  /// The values of the options of `contributes.settings`, as a JSON object by option id, the manifest's default for those the user left alone. Since 1.4.0.
  options: func() -> string;
  /// Sends a JSON message to the extension's settings page while it is open, which receives it in `squadron.on`. Since 1.4.0.
  settings-post: func(message: string);
  /// Opens the New agent window in the project of `agent`, filled from `draft`, and returns the id of the draft. `draft` is a JSON object, each key optional: `name`, `text` (the first message), `goal` (Done when), `context` (added after the first message when the agent starts, never shown in the window), `link` (`{ "key": "…", "title": "…", "url": "https://…" }`, shown at the top, with ✕ to unlink), `choices` (`{ "label": "…", "items": [{ "id": "…", "label": "…", "on": true }] }`, checkboxes), `status` (`{ "state": "running", "done" or "error", "text": "…" }`). Labels and texts are strings or `{ "en": "…", "fr": "…" }`. Since 1.5.0.
  open-new-agent: func(agent: string, draft: string) -> string;
  /// Fills the open draft `id` with the keys of `draft`. `name`, `text` and `goal` stay as the user left them once they edited them. Since 1.5.0.
  update-new-agent: func(id: string, draft: string);
  /// The projects of Squadron, archived ones included. Needs `projects: ["read"]` in `permissions`. Since 1.7.0.
  projects: func() -> result<list<project>, string>;
  /// The groups of projects. Needs `projects: ["read"]` in `permissions`. Since 1.7.0.
  groups: func() -> result<list<group>, string>;
  /// Every agent, archived ones included, and what it is doing. Needs `agents: ["activity"]` in `permissions`. Since 1.7.0.
  all-agents: func() -> result<list<agent-activity>, string>;
  /// Claude's 5-hour and weekly limits and the state of its API. Needs `usage: ["read"]` in `permissions`. Since 1.7.0.
  usage: func() -> result<claude-usage, string>;
  /// Brings an agent to the front in Squadron, an archived one in the archive of its project, read only. Only within 2 s of a message from one of the extension's panels, while that panel is on screen and holds the focus, once a second at most. It never acts on the agent. Needs `agents: ["show"]` in `permissions`. Since 1.7.0.
  show-agent: func(agent: string) -> result<_, string>;
}

/// The exports every version of the API has. Squadron binds to it, so that an extension built before 1.6.0 still loads.
world squadron-core {
  use types.{agent};
  import host;

  /// Something happened: `started` once the extension is loaded, `agent.done` when an agent finished its turn, `agent.waiting` when it waits for the user, `panel.message` when one of its panels called `squadron.send`, with `{ "panel": "…", "message": … }`, `timer` when the delay of `set-timer` is over, `accounts.changed` when the user added, changed or removed one of its accounts, `options.changed` with the values of `options` when the user changed one, `settings.message` when its settings page called `squadron.send`, with `{ "message": … }`, `new-agent.regenerate` when the user clicked Regenerate or changed the choices of a draft, with `{ "draft": "…", "choices": ["…"] }`, `new-agent.started` with `{ "draft": "…" }` and the agent that started, `new-agent.closed` with `{ "draft": "…" }` when the window closed without starting one, `panel.closed` with `{ "panel": "…" }` when one of its panels closed. Without `agents: ["read"]`, `agent.done` and `agent.waiting` give an agent whose `dir` is empty and whose `project` is the opaque id, and `agent.waiting` gives `{ "kind": "permission" or "question" }`. With `agents: ["activity"]`: `agent.status` with the `agent-activity` of an agent that changed, `agent.started` with it and `by`, `agent.archived` with it, `agent.message` with `{ "from": "…", "to": "…", "count": 1 }` when an agent sent messages to another. With `projects: ["read"]`: `project.added`, `project.changed` and `project.archived` with the `project`, `groups.changed` with `{ "groups": [ … ] }`. With `usage: ["read"]`: `usage` with the `claude-usage`. These come at most once a second, the latest state of each agent or project only. `data` is JSON.
  export on-event: func(name: string, agent: option<agent>, data: string);
  /// One of the extension's items with the action `{ "run": "<action>" }` was clicked.
  export run: func(action: string, agent: option<agent>) -> result<_, string>;
  /// An agent called one of the extension's tools that has no `command`. `input` is JSON.
  export call-tool: func(name: string, input: string, agent: option<agent>) -> result<string, string>;
}

world squadron-extension {
  use types.{account};
  include squadron-core;

  /// Tests an account, from `contributes.accounts` with `"check": true`: when the user clicks Test the connection, with an account that is not saved yet, and when the extension's page opens, with each saved one. While it runs, `{{<account.id>.<field>}}` in `fetch` gives its fields and secrets, and its `host` field is reachable; `accounts` does not list an account that is not saved. `ok` is JSON or a plain text: `{ "text": "Connected as Ada", "detail": "12 projects" }`. `err` likewise: `{ "title": "…", "detail": "…", "field": "<field id>" }`, `field` marking the field to fix. Texts are strings or `{ "en": "…", "fr": "…" }`. Since 1.6.0.
  export check-account: func(account: account) -> result<string, string>;
}
